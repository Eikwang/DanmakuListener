# DanmakuListener 配置示例
# 复制此文件为 .env.local 并填写实际值

# ===== 日志配置 =====
LOG_LEVEL=INFO

# ===== 代理服务器配置 =====
PROXY_PORT=8827
LISTEN_ANY=false

# ===== 浏览器引擎配置 =====
MAX_ROOMS=10
BROWSER_HEADLESS=true

# ===== Cookie 存储 =====
COOKIE_DIR=./cookie

# ===== 重连策略 =====
RECONNECT_MAX_RETRIES=3
RECONNECT_BASE_DELAY=1